namespace sqlite;

/**
 * A compiled statement: bind its parameters, step through its rows, read the current row's
 * columns by position (from 0), then `reset` it to run it again.
 *
 * ```echo
 * sqlite::Statement $q = guard $db->prepare('SELECT id, body FROM notes WHERE id > ?');
 * guard $q->bind([.int(0)]);
 * while (true) {
 *     bool $row = guard $q->step();
 *     if (!$row) {
 *         break;
 *     }
 *     echo $q->text(1) ?? '';
 * }
 * ```
 *
 * Text and blobs are copied when they are bound and when they are read, so neither side holds
 * on to the other's memory. A statement keeps its connection alive but is not for sharing
 * between threads.
 */
public class Statement
{
    // keeps the connection open for as long as the statement lives
    internal Database $db;
    internal ptr<Prepared> $raw;

    internal constructor(Database $db, ptr<Prepared> $raw)
    {
        $this->db = $db;
        $this->raw = $raw;
    }

    destructor()
    {
        if ($this->raw != null) {
            c_finalize($this->raw);
            $this->raw = null;
        }
    }

    /**
     * How many parameters the statement has.
     */
    public const function parameters() : usize
    {
        return c_params($this->raw) as usize;
    }

    /**
     * Bind `$v` to the parameter at `$at` (from 0). A statement that has started stepping has to
     * be `reset` first; `run` does that itself.
     */
    public function bind(usize $at, const Value& $v) : status<Error>
    {
        try $this->db->live();
        int32 $i = ($at + 1) as int32;
        int32 $rc = 0;
        ptr<Mutex> $lock = $this->db->lock();
        match ($v) {
            Value::none => {
                $rc = c_bind_null($this->raw, $i);
            },
            Value::int($x) => {
                $rc = c_bind_int($this->raw, $i, $x);
            },
            Value::float($x) => {
                $rc = c_bind_float($this->raw, $i, $x);
            },
            // -1 is SQLITE_TRANSIENT (SQLite copies the bytes), 1 is SQLITE_UTF8
            Value::text($x) => {
                if ($x->empty()) {
                    string $blank = '';
                    $rc = c_bind_text($this->raw, $i, $blank->cstr(), 0, -1, 1);
                } else {
                    $rc = c_bind_text($this->raw, $i, $x->data(), $x->size() as uint64, -1, 1);
                }
            },
            Value::blob($x) => {
                if ($x->empty()) {
                    $rc = c_bind_zeroblob($this->raw, $i, 0);
                } else {
                    $rc = c_bind_blob($this->raw, $i, $x->data(), $x->size() as uint64, -1);
                }
            },
        };
        if ($rc != 0) {
            Error $e = Error::of($this->db->raw, $rc);
            c_unlock($lock);
            return .error($e);
        }
        c_unlock($lock);
        return .ok();
    }

    /**
     * Bind every parameter in order, from the first.
     */
    public function bind(const array<Value>& $values) : status<Error>
    {
        usize $at = 0;
        foreach ($values as const &$v) {
            try $this->bind($at, $v);
            $at++;
        }
        return .ok();
    }

    /**
     * Move to the next row: true when there is one, false once the statement is done.
     */
    public function step() : result<bool, Error>
    {
        try $this->db->live();
        ptr<Mutex> $lock = $this->db->lock();
        int32 $rc = c_step($this->raw);
        if ($rc == Code::row->value()) {
            c_unlock($lock);
            return .ok(true);
        }
        if ($rc == Code::done->value()) {
            c_unlock($lock);
            return .ok(false);
        }
        Error $e = Error::of($this->db->raw, $rc);
        c_unlock($lock);
        return .error($e);
    }

    /**
     * Step until done, for a statement run for what it does, then reset it (bindings stay), so it
     * is ready to bind and run again whether it worked or not.
     */
    public function run() : status<Error>
    {
        while (true) {
            bool $more = guard $this->step() else ($e) {
                c_reset($this->raw);
                return .error($e);
            }
            if (!$more) {
                c_reset($this->raw);
                return .ok();
            }
        }
        return .ok();
    }

    /**
     * Make the statement ready to run again. Bindings stay unless `$clear`.
     */
    public function reset(bool $clear = false) : void
    {
        c_reset($this->raw);
        if ($clear) {
            c_clear($this->raw);
        }
    }

    /**
     * How many columns a row has.
     */
    public const function columns() : usize
    {
        return c_columns($this->raw) as usize;
    }

    /**
     * The name of the column at `$at`.
     */
    public const function name(usize $at) : string
    {
        return copyText(c_column_name($this->raw, $at as int32));
    }

    /**
     * The storage class of the current row's value at `$at`.
     */
    public const function kind(usize $at) : Kind
    {
        return Kind::from(c_column_type($this->raw, $at as int32)) ?? Kind::none;
    }

    /**
     * Whether the current row's value at `$at` is NULL.
     */
    public const function isNull(usize $at) : bool
    {
        return $this->kind($at) == Kind::none;
    }

    /**
     * The value at `$at` as an integer, null for NULL. SQLite converts text and floats.
     */
    public const function int(usize $at) : int64?
    {
        if ($this->isNull($at)) {
            return null;
        }
        return c_column_int($this->raw, $at as int32);
    }

    /**
     * The value at `$at` as a float, null for NULL. SQLite converts text and integers.
     */
    public const function float(usize $at) : float64?
    {
        if ($this->isNull($at)) {
            return null;
        }
        return c_column_float($this->raw, $at as int32);
    }

    /**
     * The value at `$at` as text, null for NULL. Numbers come back as SQLite prints them.
     */
    public const function text(usize $at) : string?
    {
        if ($this->isNull($at)) {
            return null;
        }
        ptr<const uint8> $p = c_column_text($this->raw, $at as int32);
        int32 $n = c_column_bytes($this->raw, $at as int32);
        return copyBytes($p, $n as usize);
    }

    /**
     * The value at `$at` as bytes, null for NULL.
     */
    public const function blob(usize $at) : string?
    {
        if ($this->isNull($at)) {
            return null;
        }
        ptr<const uint8> $p = c_column_blob($this->raw, $at as int32);
        int32 $n = c_column_bytes($this->raw, $at as int32);
        return copyBytes($p, $n as usize);
    }
}
