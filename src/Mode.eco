namespace sqlite;

/**
 * How `Database::open` opens a file.
 */
public enum Mode
{
    /**
     * Reads only; the file has to exist.
     */
    case readOnly;

    /**
     * Reads and writes; the file has to exist.
     */
    case readWrite;

    /**
     * Reads and writes, creating the file when it is missing.
     */
    case create;

    /**
     * The `SQLITE_OPEN_*` flags, always with a serialized connection (one may cross threads) and
     * URI filenames.
     */
    internal const function flags() : int32
    {
        int32 $base = SQLITE_OPEN_FULLMUTEX | SQLITE_OPEN_URI;
        return match ($this) {
            Mode::readOnly => $base | SQLITE_OPEN_READONLY,
            Mode::readWrite => $base | SQLITE_OPEN_READWRITE,
            Mode::create => $base | SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE,
        };
    }
}
