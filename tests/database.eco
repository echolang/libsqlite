/**
 * Connections: opening, exec, counters, transactions, closing and sharing.
 */

use ecotest::expect;
use ecotest::TempDir;
use std::thread;
use std::time;

#[group: "unit"]
test a_memory_database_runs_sql
{
    $db = fresh();
    expect($db->open())->yes();
    expect($db->exec('CREATE TABLE t (v INTEGER); INSERT INTO t VALUES (1); INSERT INTO t VALUES (2)'))->fine();
    expect($db->changes())->is(1);
    expect($db->lastInsertId())->is(2);
    expect(count($db, 't'))->is(2);
}

#[group: "unit"]
test memory_names_open_through_open_too
{
    sqlite::Database $plain = expect(sqlite::Database::open(':memory:'))->ok();
    expect($plain->exec('CREATE TABLE t (v INTEGER)'))->fine();
    sqlite::Database $uri = expect(sqlite::Database::open('file::memory:?cache=private'))->ok();
    expect($uri->exec('CREATE TABLE t (v INTEGER)'))->fine();
}

#[group: "unit"]
test exec_reports_bad_sql
{
    $db = fresh();
    sqlite::Error $e = expect($db->exec('SELEKT 1'))->fails();
    expect($e->primary() == sqlite::Code::error)->yes(says: 'a plain error');
    expect($e->message)->has('syntax error');
}

#[group: "unit"]
test exec_takes_a_substring
{
    $db = fresh();
    string $sql = 'CREATE TABLE t (v INTEGER); this is not sql';
    expect($db->exec($sql->sub(0, 26)))->fine();
    expect(count($db, 't'))->is(0);
}

#[group: "unit"]
test changes_count_the_rows_of_the_last_write
{
    $db = fresh();
    expect($db->exec('CREATE TABLE t (v INTEGER); INSERT INTO t VALUES (1), (2), (3)'))->fine();
    expect($db->changes())->is(3);
    expect($db->exec('UPDATE t SET v = v + 1 WHERE v > 1'))->fine();
    expect($db->changes())->is(2);
    expect($db->exec('DELETE FROM t'))->fine();
    expect($db->changes())->is(3);
}

#[group: "unit"]
test transactions_commit_and_roll_back
{
    $db = fresh();
    expect($db->exec('CREATE TABLE t (v INTEGER)'))->fine();
    expect($db->autocommit())->yes();
    expect($db->exec('BEGIN IMMEDIATE'))->fine();
    expect($db->autocommit())->no();
    expect($db->exec('INSERT INTO t VALUES (1)'))->fine();
    expect($db->exec('ROLLBACK'))->fine();
    expect($db->autocommit())->yes();
    expect($db->exec('BEGIN; INSERT INTO t VALUES (2); COMMIT'))->fine();
    sqlite::Statement $q = expect($db->prepare('SELECT group_concat(v) FROM t'))->ok();
    expect($q->step())->ok(true);
    expect($q->text(0))->some('2');
}

#[group: "unit"]
test prepare_compiles_only_the_first_statement
{
    $db = fresh();
    expect($db->exec('CREATE TABLE t (v INTEGER)'))->fine();
    sqlite::Statement $ins = expect($db->prepare('INSERT INTO t VALUES (1); INSERT INTO t VALUES (2)'))->ok();
    expect($ins->run())->fine();
    expect(count($db, 't'))->is(1);
}

#[group: "unit"]
test sql_without_a_statement_is_an_error
{
    $db = fresh();
    // leaves an older error on the connection that must not leak into the next one
    expect($db->exec('SELEKT 1'))->fails();
    sqlite::Error $blank = expect($db->prepare(''))->fails();
    expect($blank->is(.misuse))->yes();
    expect($blank->message)->is('there is no statement in the SQL');
    sqlite::Error $comment = expect($db->prepare('  -- nothing'))->fails();
    expect($comment->message)->is('there is no statement in the SQL');
}

#[group: "unit"]
test busy_timeout_takes_zero_and_huge_waits
{
    $db = fresh();
    $db->busyTimeout(.zero());
    expect($db->exec('SELECT 1'))->fine();
    $db->busyTimeout(time::duration::secs(10000000));
    expect($db->exec('SELECT 1'))->fine();
}

#[group: "unit"]
test the_linked_library_is_new_enough
{
    // sqlite3_changes64 arrived in 3.37.0
    expect(sqlite::Database::version())->above(3036999);
}

#[group: "unit"]
test closed_connections_refuse_and_answer_defaults
{
    $db = fresh();
    $db->close();
    $db->close();
    expect($db->open())->no();
    sqlite::Error $e = expect($db->exec('SELECT 1'))->fails();
    expect($e->is(.misuse))->yes();
    expect($e->message)->is('the connection is closed');
    expect($db->prepare('SELECT 1'))->fails();
    expect($db->changes())->is(0);
    expect($db->lastInsertId())->is(0);
    expect($db->autocommit())->yes();
    $db->busyTimeout(time::duration::secs(1));
}

#[group: "unit"]
test a_statement_keeps_its_connection_alive
{
    sqlite::Statement $q = orphan();
    expect($q->step())->ok(true);
    expect($q->int(0))->some(7);
}

#[group: "file"]
test a_file_keeps_its_rows
{
    $dir = TempDir();
    string $file = $dir->file('kept.sqlite');
    {
        sqlite::Database $db = expect(sqlite::Database::open($file))->ok();
        expect($db->exec("CREATE TABLE t (v TEXT); INSERT INTO t VALUES ('kept')"))->fine();
    }
    sqlite::Database $again = expect(sqlite::Database::open($file, mode: .readWrite))->ok();
    sqlite::Statement $q = expect($again->prepare('SELECT v FROM t'))->ok();
    expect($q->step())->ok(true);
    expect($q->text(0))->some('kept');
}

#[group: "file"]
test read_only_reads_and_refuses_writes
{
    $dir = TempDir();
    string $file = $dir->file('ro.sqlite');
    {
        sqlite::Database $db = expect(sqlite::Database::open($file))->ok();
        expect($db->exec('CREATE TABLE t (v INTEGER); INSERT INTO t VALUES (1)'))->fine();
    }
    sqlite::Database $ro = expect(sqlite::Database::open($file, mode: .readOnly))->ok();
    expect(count($ro, 't'))->is(1);
    sqlite::Error $e = expect($ro->exec('INSERT INTO t VALUES (2)'))->fails();
    expect($e->is(.readOnly))->yes();
}

#[group: "file"]
test a_missing_file_opens_only_with_create
{
    $dir = TempDir();
    sqlite::Error $rw = expect(sqlite::Database::open($dir->file('nope.sqlite'), mode: .readWrite))->fails();
    expect($rw->is(.cannotOpen))->yes();
    expect($rw->message)->has('unable to open');
    expect(sqlite::Database::open($dir->file('nope.sqlite'), mode: .readOnly))->fails();
    expect(sqlite::Database::open($dir->file('nope.sqlite'), mode: .create))->ok();
}

#[group: "threads"]
test one_connection_serves_several_threads
{
    $db = fresh();
    expect($db->exec('CREATE TABLE t (v INTEGER)'))->fine();
    $work = function() : void {
        int32 $i = 0;
        while ($i < 50) {
            guard $db->exec('INSERT INTO t VALUES (1)') else {
                return;
            }
            $i++;
        }
    };
    {
        thread::handle $a = spawn($work);
        thread::handle $b = spawn($work);
        thread::handle $c = spawn($work);
        thread::handle $d = spawn($work);
    }
    expect(count($db, 't'))->is(200);
}

/**
 * A statement whose connection only it still holds.
 */
function orphan() : sqlite::Statement
{
    $db = fresh();
    return expect($db->prepare('SELECT 7'))->ok();
}

/**
 * `$work` on a thread of its own; one that cannot start stops the test.
 */
function spawn(function<void()> $work) : thread::handle
{
    thread::handle $h = guard thread::spawn($work) else ($e) {
        die("cannot start a thread: {$e->message()}");
    };
    return $h;
}
